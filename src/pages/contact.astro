---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';

const action = site.formEndpoint || (site.email ? `mailto:${site.email}` : '');
const isMailto = action.startsWith('mailto:');
const topics = [
  { value: 'consulting', label: 'Consulting — capital, launch or finance' },
  { value: 'speaking', label: 'Speaking or keynote' },
  { value: 'workshop', label: 'Workshop or training for a group' },
  { value: 'book', label: 'Books — notify me' },
  { value: 'video', label: 'Video lesson request' },
  { value: 'media', label: 'Media or partnership' },
  { value: 'other', label: 'Something else' },
];
---

<Base title="Contact" description="Start a conversation about consulting, speaking, workshops or media.">
  <PageHead
    eyebrow="Contact"
    title="Tell me where you are. <em>I’ll tell you honestly</em> how I can help."
  />

  <section class="section--tight container grid-12">
    <div class="span-12 span-7">
      {action ? (
        <form class="form" action={action} method="post" enctype={isMailto ? 'text/plain' : undefined}>
          <div class="two">
            <div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
            <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
          </div>
          <div class="two">
            <div class="field"><label for="company">Business or organization</label><input id="company" name="company" autocomplete="organization" /></div>
            <div class="field">
              <label for="topic">What’s this about?</label>
              <select id="topic" name="topic">{topics.map((t) => <option value={t.value}>{t.label}</option>)}</select>
            </div>
          </div>
          <div class="field"><label for="message">Message</label><textarea id="message" name="message" rows="7" required placeholder="A few lines about your business, your goal and your timeline."></textarea></div>
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
          <div><button class="btn" type="submit">Send message <span class="arrow" aria-hidden="true">→</span></button></div>
        </form>
      ) : (
        <div class="card stack">
          <p class="h3">The fastest way to reach me is LinkedIn.</p>
          <p class="muted">Send a message with a few lines about your business, your goal and your timeline, and I’ll reply personally.</p>
          <p><a class="btn" href={site.social.linkedin} target="_blank" rel="noopener">Message me on LinkedIn <span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
      )}
    </div>
    <aside class="span-12 span-4 start-9 side">
      <div>
        <p class="eyebrow">Based in</p>
        <p>{site.location}</p>
        <p class="muted small">Serving West Georgia and East Alabama in person, and clients and audiences nationwide online.</p>
      </div>
      {site.email && <div><p class="eyebrow">Email</p><p><a href={`mailto:${site.email}`}>{site.email}</a></p></div>}
      <div><p class="eyebrow">Elsewhere</p><p><a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a></p></div>
      {site.bookingUrl && <div><a class="btn btn--ghost" href={site.bookingUrl}>Book a call</a></div>}
    </aside>
  </section>
</Base>

<script>
  const topic = new URLSearchParams(location.search).get('topic');
  const select = document.getElementById('topic') as HTMLSelectElement | null;
  if (topic && select && [...select.options].some((o) => o.value === topic)) select.value = topic;
</script>

<style>
  .form { display: grid; gap: var(--space-m); padding-bottom: var(--space-xl); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-m); }
  @media (max-width: 40rem) { .two { grid-template-columns: 1fr; } }
  .side { display: grid; gap: var(--space-l); align-content: start; }
  .side .eyebrow { margin-bottom: var(--space-2xs); }
  .small { font-size: var(--text-sm); margin-top: var(--space-2xs); }
</style>
