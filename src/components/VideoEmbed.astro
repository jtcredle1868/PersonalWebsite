---
interface Props { title: string; youtubeId?: string; vimeoId?: string; videoUrl?: string }
const { title, youtubeId, vimeoId, videoUrl } = Astro.props;
const src = youtubeId
  ? `https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0`
  : vimeoId
    ? `https://player.vimeo.com/video/${vimeoId}?dnt=1`
    : undefined;
---

<div class="frame">
  {src ? (
    <iframe src={src} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
  ) : videoUrl ? (
    <video src={videoUrl} controls preload="metadata" title={title}></video>
  ) : (
    <div class="missing"><p>Video coming soon</p></div>
  )}
</div>

<style>
  .frame { position: relative; aspect-ratio: 16 / 9; background: var(--color-surface-sunken); border: 1px solid var(--color-line); border-radius: var(--radius-m); overflow: hidden; }
  iframe, video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .missing { position: absolute; inset: 0; display: grid; place-items: center; color: var(--color-muted); font-family: var(--font-display); font-style: italic; }
</style>
