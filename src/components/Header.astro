---
import { nav, site } from '../data/site';
import { url } from '../lib/url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(base, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href={url('/')} aria-label={`${site.name} — home`}>
      <span class="mark" aria-hidden="true">TC</span>
      <span class="name">Thomas Credle</span>
    </a>

    <nav aria-label="Primary">
      <button class="menu-toggle" aria-expanded="false" aria-controls="primary-menu">
        <span class="visually-hidden">Menu</span>
        <span class="bars" aria-hidden="true"></span>
      </button>
      <ul id="primary-menu" class="menu">
        {nav.map((item) => (
          <li><a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li class="cta"><a class="btn" href={url('/contact')}>Work with me</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('primary-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); min-height: 4.25rem; }
  .wordmark { display: inline-flex; align-items: center; gap: var(--space-xs); text-decoration: none; }
  .mark {
    font-family: var(--font-display); font-size: var(--text-sm); font-style: italic;
    width: 2.25rem; height: 2.25rem; display: grid; place-items: center;
    border: 1px solid var(--color-ink); border-radius: 50%;
    letter-spacing: -0.04em;
  }
  .name { font-family: var(--font-display); font-size: var(--text-lg); letter-spacing: -0.01em; }
  .menu { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: var(--space-m); }
  .menu a:not(.btn) { text-decoration: none; font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-ink-soft); position: relative; padding-block: 0.3rem; }
  .menu a:not(.btn):hover, .menu a[aria-current='page'] { color: var(--color-ink); }
  .menu a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: var(--color-brass); }
  .menu-toggle { display: none; }

  @media (max-width: 64rem) {
    .menu-toggle {
      display: grid; place-items: center; width: 2.75rem; height: 2.75rem;
      background: transparent; border: 1px solid var(--color-line-strong); border-radius: var(--radius-s); cursor: pointer; color: var(--color-ink);
    }
    .bars, .bars::before, .bars::after { display: block; width: 18px; height: 1.5px; background: currentColor; position: relative; transition: transform var(--duration-s); }
    .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
    .bars::before { top: -6px; } .bars::after { top: 6px; }
    .menu-toggle[aria-expanded='true'] .bars { background: transparent; }
    .menu-toggle[aria-expanded='true'] .bars::before { transform: translateY(6px) rotate(45deg); }
    .menu-toggle[aria-expanded='true'] .bars::after { transform: translateY(-6px) rotate(-45deg); }
    .menu {
      display: none; position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--color-surface); border-bottom: 1px solid var(--color-line);
      padding: var(--space-xs) var(--gutter) var(--space-m);
    }
    .menu.open { display: flex; }
    .menu li { border-bottom: 1px solid var(--color-line); }
    .menu li.cta { border: 0; padding-top: var(--space-s); }
    .menu a:not(.btn) { display: block; padding-block: var(--space-xs); font-size: var(--text-base); }
    .menu a[aria-current='page']::after { display: none; }
  }
</style>
